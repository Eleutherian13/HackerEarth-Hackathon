# Development environment variables
APP_NAME=Court Judgment Action System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-32-characters-long-key
TESTING=false

DATABASE_URL=postgresql://laos:devpassword@localhost:5432/laos
DATABASE_PASSWORD=devpassword
DATABASE_MAX_CONNECTIONS=20
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

JWT_SECRET_KEY=dev-jwt-secret-32-characters-long-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=50

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.0
OLLAMA_MAX_TOKENS=4096

OCR_LANGUAGE=eng+hin
OCR_ENGINE=paddleocr
EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_TEMPERATURE=0.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_CONFIDENCE_THRESHOLD=0.60
HIGH_CONFIDENCE_THRESHOLD=0.85

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_FILE_PATH=
SENTRY_DSN=