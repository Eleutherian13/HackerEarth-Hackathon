# Staging environment variables
APP_NAME=Court Judgment Action System
APP_VERSION=1.0.0
ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=staging-secret-key-32-characters-long
TESTING=false

DATABASE_URL=postgresql://laos:stagingpassword@staging-db:5432/laos
DATABASE_MAX_CONNECTIONS=20
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=10
DATABASE_PASSWORD=stagingpassword

REDIS_URL=redis://staging-redis:6379/0
REDIS_MAX_CONNECTIONS=10

CELERY_BROKER_URL=redis://staging-redis:6379/0
CELERY_RESULT_BACKEND=redis://staging-redis:6379/1

JWT_SECRET_KEY=staging-jwt-secret-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=50

OCR_LANGUAGE=eng+hin
OCR_ENGINE=paddleocr
EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_TEMPERATURE=0.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_CONFIDENCE_THRESHOLD=0.60
HIGH_CONFIDENCE_THRESHOLD=0.85

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=200
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=
SENTRY_DSN=