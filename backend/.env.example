# LAOS Configuration - Court Judgment Action System
# Copy this file to .env and configure for your environment

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Court Judgment Action System"
APP_VERSION="1.0.0"
ENVIRONMENT=development  # development, staging, production
DEBUG=true
SECRET_KEY=your-secret-key-minimum-32-characters-long!

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/laos
DATABASE_MAX_CONNECTIONS=20
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=10

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# CELERY / ASYNC TASKS
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# JWT / AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_BACKEND=local  # local or s3
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# OCR / EXTRACTION / AI
# =============================================================================
OCR_LANGUAGE=eng+hin
OCR_ENGINE=paddleocr  # tesseract or paddleocr
EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_TEMPERATURE=0.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_CONFIDENCE_THRESHOLD=0.60
HIGH_CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG  # Use DEBUG for development, INFO for staging, INFO/WARNING for production

# Log format: json (structured) or text (human-readable)
LOG_FORMAT=text  # Use text for development, json for production

# Optional: Path to log file (if not set, only logs to stdout)
# LOG_FILE_PATH=./logs/app.log

# Examples of LOG_FILE_PATH usage:
# - /var/log/laos/app.log (production Linux)
# - C:\logs\laos\app.log (Windows)
# - ./logs/app.log (relative path)
# - /dev/stdout (always stdout, useful in containers)

# =============================================================================
# ERROR TRACKING / SENTRY (OPTIONAL)
# =============================================================================
# SENTRY_DSN=https://your-sentry-key@sentry.io/project-id
# Leave empty to disable Sentry error tracking

# =============================================================================
# ENVIRONMENT PROFILES
# =============================================================================
# Development:
#   ENVIRONMENT=development
#   DEBUG=true
#   LOG_LEVEL=DEBUG
#   LOG_FORMAT=text
#   DATABASE_URL=postgresql://localhost/laos_dev
#
# Staging:
#   ENVIRONMENT=staging
#   DEBUG=false
#   LOG_LEVEL=INFO
#   LOG_FORMAT=json
#   LOG_FILE_PATH=/var/log/laos/app.log
#   DATABASE_URL=postgresql://user:password@staging-db/laos
#
# Production:
#   ENVIRONMENT=production
#   DEBUG=false
#   LOG_LEVEL=INFO
#   LOG_FORMAT=json
#   LOG_FILE_PATH=/var/log/laos/app.log
#   DATABASE_URL=postgresql://user:password@prod-db/laos
#   SENTRY_DSN=https://key@sentry.io/project-id
